[
  {
    "n": 1,
    "name": "Recall for tier evidence before dispatch",
    "signal": "bash_regex",
    "pattern": "engram\\s+query.*(?:tier|route[- ]evidence)"
  },
  {
    "n": 2,
    "name": "Dispatch implementation to subagent with explicit cheapest-tier model",
    "signal": "tool_input_regex",
    "tool": "Agent",
    "regex": "\"model\"\\s*:\\s*\"haiku\"",
    "case_insensitive": true
  },
  {
    "n": 3,
    "name": "Handoff contains recall-first instruction",
    "signal": "tool_input_regex",
    "tool": "Agent",
    "regex": "(?:recall\\b|engram\\s+query)"
  },
  {
    "n": 4,
    "name": "Handoff contains LESSONS: completion report contract",
    "signal": "tool_input_regex",
    "tool": "Agent",
    "regex": "LESSONS:"
  },
  {
    "n": 5,
    "name": "Handoff contains acceptance checks",
    "any_of": [
      {"signal": "tool_input_regex", "tool": "Agent", "regex": "pytest"},
      {"signal": "tool_input_regex", "tool": "Agent", "regex": "acceptance"},
      {"signal": "tool_input_regex", "tool": "Agent", "regex": "test"}
    ]
  },
  {
    "n": 6,
    "name": "Handoff contains do-not-touch bounds",
    "signal": "tool_input_regex",
    "tool": "Agent",
    "regex": "(?:do[- ]not[- ]touch|must not (?:modify|change|edit)|do not (?:modify|change|edit)|leave .* (?:alone|untouched|as[- ]is)|out of scope)",
    "case_insensitive": true
  },
  {
    "n": 7,
    "name": "Run tests after the agent completes",
    "signal": "bash_regex",
    "pattern": "pytest\\b",
    "after": 2
  },
  {
    "n": 8,
    "name": "Write evidence note with route-dispatch-* slug",
    "signal": "bash_regex",
    "pattern": "engram\\s+learn\\s+fact.*--slug\\s+route-dispatch-"
  },
  {
    "n": 9,
    "name": "Evidence note includes all three required tags",
    "any_of": [
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?work-kind/.*--tag\\s+[\"']?tier/.*--tag\\s+[\"']?outcome/"},
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?work-kind/.*--tag\\s+[\"']?outcome/.*--tag\\s+[\"']?tier/"},
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?tier/.*--tag\\s+[\"']?work-kind/.*--tag\\s+[\"']?outcome/"},
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?tier/.*--tag\\s+[\"']?outcome/.*--tag\\s+[\"']?work-kind/"},
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?outcome/.*--tag\\s+[\"']?work-kind/.*--tag\\s+[\"']?tier/"},
      {"signal": "bash_regex", "pattern": "--tag\\s+[\"']?outcome/.*--tag\\s+[\"']?tier/.*--tag\\s+[\"']?work-kind/"}
    ]
  },
  {
    "n": 10,
    "name": "Aggregate: query route evidence then amend or learn (or, when no prior aggregate exists, create one)",
    "any_of": [
      {"signal": "bash_regex", "pattern": "engram\\s+query.*route[- ]evidence.*engram\\s+(?:amend|learn)"},
      {"signal": "bash_regex", "pattern": "engram\\s+(?:amend|learn).*--target.*route-evidence"},
      {"signal": "bash_regex", "pattern": "engram\\s+learn\\s+fact.*--slug\\s+route-evidence-"}
    ],
    "after": 8
  }
]
