{
  "name": "engram-acceptance",
  "private": true,
  "type": "module",
  "description": "Acceptance harness for the parallel memory agent (793e): cucumber-js over real Claude Code sessions driven by the Agent SDK",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node --test test/self/",
    "postinstall": "node prune-go-sources.js"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
